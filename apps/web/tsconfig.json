{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@sim/contracts": ["../../packages/contracts/src/index.ts"],
      "@sim/definitions": ["../../packages/definitions/src/index.ts"],
      "@sim/rule-engine": ["../../packages/rule-engine/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
