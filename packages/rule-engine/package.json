{
  "name": "@sim/rule-engine",
  "version": "0.1.0",
  "private": true,
  "description": "校验规则引擎（纯函数，前后端复用）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sim/contracts": "*"
  },
  "devDependencies": {
    "@sim/definitions": "*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
